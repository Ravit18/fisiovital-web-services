# Copia este archivo como .env (en la misma carpeta que pom.xml) y pega tus valores.
# .env NO se sube a GitHub. Nunca pongas la key en application.properties ni en Postman.

# Google Gemini (plan gratuito) - asistente con IA (US17-US20). Ver README, seccion "API key de Gemini".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Gmail para los recordatorios por correo (US13). Ver README, seccion "Correo de recordatorios".
# MAIL_PASSWORD es una contrasena de aplicacion de 16 letras, sin espacios (NO tu contrasena normal).
MAIL_USERNAME=
MAIL_PASSWORD=

# PostgreSQL local (opcional). Solo si tu Postgres no usa el puerto 5432 o la clave "postgres".
# Ejemplo: DB_URL=jdbc:postgresql://localhost:5433/fisiovital
# DB_URL=
# DB_PASSWORD=
